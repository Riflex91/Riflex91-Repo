{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-v4.invalid/schemata/vorfall.schema.json",
  "title": "V4 Vorfall",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "vorfallKennung", "art", "schwere", "entdecktAm", "ablaufKennung", "zustand", "ursache", "botReaktion", "nutzerAktion", "mussNutzerHandeln", "meldung"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "vorfallKennung": { "type": "string", "minLength": 1 },
    "art": { "enum": ["stillstand", "schleife", "zeitueberschreitung", "unerwarteter_zustandswechsel"] },
    "schwere": { "enum": ["hinweis", "warnung", "fehler", "kritisch"] },
    "entdecktAm": { "type": "number", "minimum": 0 },
    "ablaufKennung": { "type": "string", "minLength": 1 },
    "zustand": { "type": "string", "minLength": 1 },
    "ursache": { "type": "string", "minLength": 1 },
    "botReaktion": { "type": "string", "minLength": 1 },
    "nutzerAktion": { "type": "string", "minLength": 1 },
    "mussNutzerHandeln": { "type": "boolean" },
    "meldung": { "$ref": "https://aio-v4.invalid/schemata/bot-meldung.schema.json" }
  }
}
