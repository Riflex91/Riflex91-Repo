{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-v4.invalid/schemata/konto-profil.schema.json",
  "title": "V4 Kontoprofil ohne Geheimnisse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kontoKennung", "anzeigename", "anmeldeArt", "anmeldeZustand", "verbundTeilnahmeErlaubt"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "kontoKennung": { "type": "string", "minLength": 1 },
    "anzeigename": { "type": "string", "minLength": 1 },
    "emailAnzeige": { "type": "string" },
    "anmeldeArt": { "enum": ["manuell", "gespeicherte_sitzung"] },
    "anmeldeZustand": { "enum": ["nicht_angemeldet", "angemeldet", "sitzung_abgelaufen", "gesperrt"] },
    "verbundTeilnahmeErlaubt": { "type": "boolean" }
  }
}
