{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-v4.invalid/schemata/tages-bericht-einstellung.schema.json",
  "title": "V4 Tagesbericht-Einstellung",
  "type": "object",
  "additionalProperties": false,
  "required": ["aktiviert", "versandUhrzeit", "zeitzone", "versandArten"],
  "properties": {
    "aktiviert": { "type": "boolean" },
    "versandUhrzeit": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "zeitzone": { "type": "string", "minLength": 1 },
    "versandArten": {
      "type": "array",
      "items": { "enum": ["email", "web_oberflaeche"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "empfaengerEmail": { "type": "string", "format": "email" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "versandArten": { "contains": { "const": "email" } }
        },
        "required": ["versandArten"]
      },
      "then": { "required": ["empfaengerEmail"] }
    }
  ]
}
