# Nur serverseitig verwenden. Niemals nach Adventure Land oder in die Web-Oberflaeche kopieren.
# Erste vorgesehene Konfiguration: Backblaze B2 Cloud Storage ueber die S3-kompatible API.
# Keine echten Zugangsdaten in Git eintragen.
V4_ARCHIV_ANBIETER=backblaze-b2
V4_ARCHIV_S3_ENDPUNKT=https://s3.<region>.backblazeb2.com
V4_ARCHIV_S3_REGION=<region>
V4_ARCHIV_S3_BUCKET=v4-archiv
V4_ARCHIV_S3_ZUGRIFFSSCHLUESSEL_ID=<application-key-id>
V4_ARCHIV_S3_GEHEIMSCHLUESSEL=<application-key>
V4_ARCHIV_STAMMPFAD=v4
