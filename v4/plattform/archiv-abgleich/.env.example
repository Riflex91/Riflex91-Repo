# Nur serverseitig verwenden. Niemals nach Adventure Land oder in die Web-Oberflaeche kopieren.
# Erste vorgesehene Konfiguration: Oracle Cloud Infrastructure Object Storage ueber die S3-Kompatibilitaets-API.
# Keine echten Zugangsdaten in Git eintragen.
V4_ARCHIV_ANBIETER=oci
V4_ARCHIV_S3_ENDPUNKT=https://<namespace>.compat.objectstorage.<region>.oci.customer-oci.com
V4_ARCHIV_S3_REGION=<region>
V4_ARCHIV_S3_BUCKET=v4-archiv
V4_ARCHIV_S3_ZUGRIFFSSCHLUESSEL_ID=<customer-secret-access-key>
V4_ARCHIV_S3_GEHEIMSCHLUESSEL=<customer-secret-key>
V4_ARCHIV_STAMMPFAD=v4
