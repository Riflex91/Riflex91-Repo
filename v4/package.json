{
  "name": "adventure-land-bot-v4",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "Adventure Land Bot v4 architecture baseline",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run check:architecture",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "depcruise --config dependency-cruiser.cjs apps packages",
    "test": "node --test tests/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.2.0",
    "typescript": "^7.0.2"
  }
}
