{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-v4.invalid/schemas/development-task.schema.json",
  "title": "V4 Development Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "createdAt", "priority", "facts", "hypotheses", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["bug", "regression", "unknown", "optimization", "missing_knowledge"] },
    "createdAt": { "type": "number", "minimum": 0 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "facts": { "type": "array", "items": { "type": "string" } },
    "hypotheses": { "type": "array", "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "requestedEvidence": { "type": "array", "items": { "type": "string" } }
  }
}
