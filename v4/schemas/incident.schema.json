{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-v4.invalid/schemas/incident.schema.json",
  "title": "V4 Incident",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "incidentId", "type", "severity", "startedAt", "affectedComponents", "traceIds"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "incidentId": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "warning", "error", "critical"] },
    "startedAt": { "type": "number", "minimum": 0 },
    "endedAt": { "type": ["number", "null"], "minimum": 0 },
    "affectedComponents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "traceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "bundleId": { "type": ["string", "null"] },
    "facts": { "type": "array", "items": { "type": "string" } }
  }
}
