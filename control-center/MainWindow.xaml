<Window x:Class="AioBotControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIO Bot Control Center" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AIO Bot Control Center" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Adventure Land · Raspberry Pi · Telemetry · GitHub" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Click="Refresh_Click" />
                <Button Content="Open settings folder" Click="OpenSettings_Click" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Bot health" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BotHealthText" Text="UNKNOWN" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Raspberry Pi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PiStateText" Text="OFFLINE" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Telemetry" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TelemetryStateText" Text="OFFLINE" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel><TextBlock Text="GitHub main" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GitHubCommitText" Text="not configured" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Live overview" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Character" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CharacterText" Grid.Column="1" Text="—"/>
                        <TextBlock Grid.Row="1" Text="Map" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MapText" Grid.Row="1" Grid.Column="1" Text="—"/>
                        <TextBlock Grid.Row="2" Text="Restart count" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RestartCountText" Grid.Row="2" Grid.Column="1" Text="0"/>
                        <TextBlock Grid.Row="3" Text="GitHub state" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GitHubStateText" Grid.Row="3" Grid.Column="1" Text="OFFLINE"/>
                        <TextBlock Grid.Row="4" Text="Last incident" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LastIncidentText" Grid.Row="4" Grid.Column="1" Text="None" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Text="Last refresh" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LastRefreshText" Grid.Row="5" Grid.Column="1" Text="—"/>
                    </Grid>
                    <Separator Margin="0,16" Background="#30363D"/>
                    <TextBlock Text="Control plane" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Restart, deploy and rollback controls are intentionally disabled in this foundation build until the Pi daemon exposes authenticated, idempotent command endpoints with health-check and rollback guarantees." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Restart bot" IsEnabled="False"/><Button Content="Deploy main" IsEnabled="False"/><Button Content="Rollback" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Connection setup" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Configuration is loaded from:" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,4"/>
                    <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap"/>
                    <TextBlock Text="Required endpoints" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <TextBlock Text="• GitHub repository + optional PAT" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="• Raspberry Pi host API + bearer token" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="• Read-only telemetry endpoint + read token" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="12" Margin="0,20,0,0">
                        <TextBlock Text="No gameplay authority. No browser evaluate/invoke access. Secrets stay on the Windows host and are never compiled into the Adventure Land bundle." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
