<Window x:Class="AioBotControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIO Bot Control Center"
        Height="860"
        Width="1280"
        MinHeight="720"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AIO Bot Control Center" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Alles Wichtige auf einen Blick" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Einstellungen" Click="OpenSettings_Click" MinWidth="128" Margin="0,0,10,0" />
                    <Button Content="Aktualisieren" Click="Refresh_Click" Style="{StaticResource PrimaryButton}" MinWidth="128" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="BOT" Style="{StaticResource StatusLabel}" />
                        <TextBlock x:Name="BotHealthText" Text="UNKNOWN" Style="{StaticResource StatusValue}" />
                        <TextBlock Text="Gesamtzustand" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="RASPBERRY PI" Style="{StaticResource StatusLabel}" />
                        <TextBlock x:Name="PiStateText" Text="OFFLINE" Style="{StaticResource StatusValue}" />
                        <TextBlock Text="Host-Verbindung" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TELEMETRIE" Style="{StaticResource StatusLabel}" />
                        <TextBlock x:Name="TelemetryStateText" Text="OFFLINE" Style="{StaticResource StatusValue}" />
                        <TextBlock Text="Live-Daten" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="GITHUB MAIN" Style="{StaticResource StatusLabel}" />
                        <TextBlock x:Name="GitHubCommitText" Text="not configured" Style="{StaticResource StatusValue}" FontSize="20" />
                        <TextBlock x:Name="GitHubStateText" Text="OFFLINE" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Aktueller Betrieb" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Die wichtigsten Live-Informationen des Bots." Style="{StaticResource MutedText}" Margin="0,5,0,20" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="CHARAKTER" Style="{StaticResource StatusLabel}" />
                                    <TextBlock x:Name="CharacterText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="MAP" Style="{StaticResource StatusLabel}" />
                                    <TextBlock x:Name="MapText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Neustarts" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RestartCountText" Grid.Column="1" Text="0" FontWeight="SemiBold" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Control daemon" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ControlStatusText" Grid.Row="1" Grid.Column="1" Text="NOT CONFIGURED" FontWeight="SemiBold" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="Letzte Aktualisierung" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LastRefreshText" Grid.Row="2" Grid.Column="1" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0,18" />

                        <TextBlock Text="Letzter Vorfall" FontSize="17" FontWeight="SemiBold" />
                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="16" Margin="0,10,0,0">
                            <TextBlock x:Name="LastIncidentText" Text="None" TextWrapping="Wrap" LineHeight="22" />
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Bot steuern" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Direkte Aktionen über den authentifizierten Pi-Control-Daemon." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,18" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button x:Name="StartBotButton" Grid.Row="0" Grid.Column="0" Content="Bot starten" Click="StartBot_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="StopBotButton" Grid.Row="0" Grid.Column="2" Content="Bot stoppen" Click="StopBot_Click" IsEnabled="False" Style="{StaticResource DangerButton}" />

                                <Button x:Name="RestartBotButton" Grid.Row="2" Grid.ColumnSpan="3" Content="Bot neu starten" Click="RestartBot_Click" IsEnabled="False" />

                                <Button x:Name="DeployMainButton" Grid.Row="4" Grid.Column="0" Content="Main deployen" Click="DeployMain_Click" IsEnabled="False" />
                                <Button x:Name="RollbackButton" Grid.Row="4" Grid.Column="2" Content="Rollback" Click="Rollback_Click" IsEnabled="False" Style="{StaticResource WarningButton}" />
                            </Grid>

                            <TextBlock Text="Aktionen werden erst freigeschaltet, wenn der Control-Daemon gesund und nicht beschäftigt ist."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Technik" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Im Alltag kannst du diesen Bereich eingeklappt lassen." Style="{StaticResource MutedText}" Margin="0,4,0,12" />

                            <Expander Header="Verbindungsdetails anzeigen" IsExpanded="False">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Konfigurationsdatei" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,5,0,14" />

                                    <TextBlock Text="Benötigte Verbindungen" FontWeight="SemiBold" />
                                    <TextBlock Text="GitHub Repository · Pi Host API · Pi Control API · Telemetrie"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,5,0,0" />

                                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                        <TextBlock Text="Keine Gameplay-Autorität. Keine freie Browser-Ausführung. Tokens bleiben auf den jeweiligen Hosts."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MutedText}" />
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
