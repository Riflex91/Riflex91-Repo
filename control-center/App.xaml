<Application x:Class="AioBotControlCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="PanelBrush" Color="#161B22" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#21262D" />
        <SolidColorBrush x:Key="TextBrush" Color="#F0F6FC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="HealthyBrush" Color="#3FB950" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#F85149" />
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Application.Resources>
</Application>
