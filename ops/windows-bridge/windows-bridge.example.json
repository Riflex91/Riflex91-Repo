{
  "configVersion": 4,
  "cdpEndpoint": "http://127.0.0.1:9222",
  "allowedOrigin": "https://adventure.land",
  "telemetryIngestUrl": "https://uasaygvcpusfevgmeqpk.supabase.co/functions/v1/bot-debug-ingest",
  "signalControlUrl": "https://uasaygvcpusfevgmeqpk.supabase.co/functions/v1/bot-chatgpt-signal-control",
  "telemetryTokenEnvironmentVariable": "AIO_V3_DEBUG_TELEMETRY_TOKEN",
  "botId": "pi-main",
  "telemetryEnabled": false,
  "autoStartBrowser": true,
  "preferredBrowser": "Brave",
  "pollIntervalSeconds": 5,
  "maxBackoffSeconds": 300,
  "eventLimit": 100,
  "webDashboardEnabled": true,
  "webDashboardBaseUrl": "https://aio-bot-dashboard.hansijuergenlul.workers.dev",
  "webDashboardAccount": "default",
  "webDashboardWriteKeyEnvironmentVariable": "AIO_V3_WEB_DASHBOARD_WRITE_KEY",
  "diagnosticsFtpsEnabled": false,
  "diagnosticsFtpsHost": "",
  "diagnosticsFtpsPort": 21,
  "diagnosticsFtpsUser": "",
  "diagnosticsFtpsRoot": "/diagnostics/v3",
  "diagnosticsFtpsRejectUnauthorized": true,
  "diagnosticsFtpsPasswordEnvironmentVariable": "AIO_V3_DIAGNOSTICS_FTPS_PASSWORD"
