<Window x:Class="AioBotWindowsBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIO Bot Windows Bridge"
        Width="1080" Height="920" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="AIO Bot Windows Bridge" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Adventure Land → Supabase / Backblaze-Konfiguration → ChatGPT" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Verbindung prüfen" Click="CheckConnection_Click" MinWidth="150" HorizontalAlignment="Right" />
            </DockPanel>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="BROWSER" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Bold" />
                        <TextBlock x:Name="BrowserStateText" Text="WIRD GEPRÜFT" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="lokales Brave/Edge/Chrome CDP" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="BOT" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Bold" />
                        <TextBlock x:Name="BotStateText" Text="WIRD GEPRÜFT" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock x:Name="BotIdText" Text="pi-main" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SUPABASE" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Bold" />
                        <TextBlock x:Name="SupabaseStateText" Text="WIRD GEPRÜFT" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Aio-bot · eu-west-1" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LETZTER UPLOAD" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Bold" />
                        <TextBlock x:Name="LastUploadText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock x:Name="EventCountText" Text="0 Events" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Telemetrie-Übertragung" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Schaltet nur die Windows→Supabase-Übertragung. Gameplay und Bot-Safety bleiben unberührt."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,18" />
                        <DockPanel>
                            <StackPanel>
                                <TextBlock x:Name="TelemetryDetailText" Text="Gestoppt" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="TelemetryErrorText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,12,0" />
                            </StackPanel>
                            <ToggleButton x:Name="TelemetryToggle" DockPanel.Dock="Right"
                                          Content="TELEMETRIE AUS"
                                          Checked="TelemetryToggle_Changed" Unchecked="TelemetryToggle_Changed"
                                          HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ChatGPT-Signale" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Separater Supabase-Gate: Telemetrie kann weiterlaufen, auch wenn Signale an ChatGPT gesperrt sind."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,18" />
                        <DockPanel>
                            <StackPanel>
                                <TextBlock x:Name="SignalDetailText" Text="Gesperrt" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="SignalUpdatedText" Text="" Style="{StaticResource MutedText}" Margin="0,5,12,0" />
                            </StackPanel>
                            <ToggleButton x:Name="SignalToggle" DockPanel.Dock="Right"
                                          Content="SIGNALE AUS"
                                          Checked="SignalToggle_Changed" Unchecked="SignalToggle_Changed"
                                          HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Webinterface / Cloudflare" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Der Bridge-Browser nutzt absichtlich ein eigenes Profil. Speichere den Webinterface-Write-Key hier einmalig; die Bridge überträgt nur die feste AIO-v3-Cloud-Konfiguration nach Adventure Land und aktiviert cloud.enabled im isolierten Profil."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <TextBlock x:Name="DashboardStateText" Text="Wird geprüft …" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="DashboardErrorText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="DashboardWriteKeyBox" Grid.Column="0" Height="40" Padding="10,7" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="Write-Key sicher speichern" Click="SaveDashboardWriteKey_Click" MinWidth="190" />
                        <Button Grid.Column="4" Content="Write-Key löschen" Click="DeleteDashboardWriteKey_Click" MinWidth="140" />
                    </Grid>
                    <TextBlock x:Name="DashboardKeyStateText" Text="Write-Key wird geprüft …" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="8" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Text="Backblaze B2 für den Bot" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Die Bridge speichert keyID und applicationKey geschützt mit Windows-DPAPI und übergibt die Konfiguration nur an den Bot im dedizierten Adventure-Land-Profil. Die Bridge lädt selbst keine Dateien zu Backblaze hoch."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,18,12" />
                        </StackPanel>
                        <ToggleButton x:Name="BackblazeToggle" DockPanel.Dock="Right" Content="NICHT AN BOT SENDEN" HorizontalAlignment="Right" Margin="12,0,0,0" />
                    </DockPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="S3-Endpunkt" Style="{StaticResource MutedText}" />
                            <TextBox x:Name="BackblazeEndpointBox" Height="40" Padding="10,7" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Region" Style="{StaticResource MutedText}" />
                            <TextBox x:Name="BackblazeRegionBox" Height="40" Padding="10,7" Margin="0,5,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="Bucket" Style="{StaticResource MutedText}" />
                            <TextBox x:Name="BackblazeBucketBox" Height="40" Padding="10,7" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="Pfad-Präfix" Style="{StaticResource MutedText}" />
                            <TextBox x:Name="BackblazePrefixBox" Height="40" Padding="10,7" Margin="0,5,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="Application Key ID (keyID)" Style="{StaticResource MutedText}" />
                            <TextBox x:Name="BackblazeKeyIdBox" Height="40" Padding="10,7" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="Application Key" Style="{StaticResource MutedText}" />
                            <PasswordBox x:Name="BackblazeApplicationKeyBox" Height="40" Padding="10,7" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Speichern &amp; an Bot senden" Click="SaveBackblazeSettings_Click" MinWidth="205" Margin="0,0,10,0" />
                        <Button Content="Jetzt an Bot senden" Click="SendBackblazeToBot_Click" MinWidth="155" Margin="0,0,10,0" />
                        <Button Content="Zugangsdaten löschen" Click="DeleteBackblazeCredentials_Click" MinWidth="155" />
                    </WrapPanel>
                    <TextBlock x:Name="BackblazeStateText" Text="Backblaze-Konfiguration wird geprüft …" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock x:Name="BackblazeErrorText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock x:Name="BackblazeCredentialStateText" Text="Zugangsdaten werden geprüft …" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    <TextBlock Text="Sicherheitsmodell: Die Schlüssel stehen nicht in settings.json, GitHub oder Supabase. Sie werden nur im Arbeitsspeicher der erlaubten Adventure-Land-Seite bereitgestellt und nicht in Browser-LocalStorage geschrieben. Verwende ausschließlich einen auf den Bucket al-aio-bot beschränkten Backblaze Application Key."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="10" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Text="GitHub &amp; Wissenswächter" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Der Wissenswächter prüft Adventure-Land-Quellen einmal pro Stunde und darf ausschließlich innerhalb von v5/wissensbasis lesen und schreiben."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,18,12" />
                        </StackPanel>
                        <ToggleButton x:Name="WissenswaechterToggle"
                                      DockPanel.Dock="Right"
                                      Content="WISSENSWÄCHTER AN"
                                      Checked="WissenswaechterToggle_Changed"
                                      Unchecked="WissenswaechterToggle_Changed"
                                      HorizontalAlignment="Right" Margin="12,0,0,0" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GitHub-Anmeldung" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="GitHubStateText" Text="Wird geprüft …" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="GitHubAccountText" Text="" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Bei GitHub anmelden" Click="GitHubLogin_Click" MinWidth="155" />
                        <Button Grid.Column="4" Content="Abmelden" Click="GitHubLogout_Click" MinWidth="105" />
                        <Button Grid.Column="6" Content="Jetzt aktualisieren" Click="WissenswaechterJetzt_Click" MinWidth="150" />
                    </Grid>

                    <Separator Margin="0,16,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status" Style="{StaticResource MutedText}" Margin="0,3" />
                        <TextBlock x:Name="WissenswaechterStateText" Grid.Column="1" Text="Wartet auf Initialisierung …" Margin="0,3" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Letzter Lauf" Style="{StaticResource MutedText}" Margin="0,3" />
                        <TextBlock x:Name="WissenswaechterLastRunText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Nächster Lauf" Style="{StaticResource MutedText}" Margin="0,3" />
                        <TextBlock x:Name="WissenswaechterNextRunText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="Erlaubter Bereich" Style="{StaticResource MutedText}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="v5/wissensbasis/**" Margin="0,3" />
                    </Grid>

                    <TextBlock x:Name="WissenswaechterDetailText"
                               Text="Stündliche Prüfung · bekannte Quellen + Web-Entdeckung · Git-Historie als Versionsverlauf."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="Sicherheitsgrenze: Der lokale Git-Arbeitsbaum ist per Sparse Checkout auf v5/wissensbasis/** begrenzt. Vor jedem Commit und nach jedem Rebase wird zusätzlich geprüft, dass keine Datei außerhalb dieses Bereichs verändert wurde. Force-Push ist verboten."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="12" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sichere Supabase-Anmeldung" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Der Endpunkt und die Bot-ID sind vorkonfiguriert. Ein vorhandener AIO_V3_DEBUG_TELEMETRY_TOKEN wird beim ersten Start automatisch importiert und per Windows-DPAPI geschützt gespeichert."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TokenBox" Grid.Column="0" Height="40" Padding="10,7" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="Token sicher speichern" Click="SaveToken_Click" MinWidth="165" />
                        <Button Grid.Column="4" Content="Token löschen" Click="DeleteToken_Click" MinWidth="120" />
                    </Grid>
                    <TextBlock x:Name="TokenStateText" Text="Token wird geprüft …" Style="{StaticResource MutedText}" Margin="0,10,0,0" />

                    <Expander Header="Technische Details" Margin="0,18,0,0">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Bot-ID" Style="{StaticResource MutedText}" Margin="0,4" />
                            <TextBlock x:Name="DetailBotIdText" Grid.Column="1" Margin="0,4" />
                            <TextBlock Grid.Row="1" Text="Supabase Ingest" Style="{StaticResource MutedText}" Margin="0,4" />
                            <TextBlock x:Name="IngestUrlText" Grid.Row="1" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Webinterface" Style="{StaticResource MutedText}" Margin="0,4" />
                            <TextBlock x:Name="DashboardUrlText" Grid.Row="2" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Text="Backblaze Endpoint" Style="{StaticResource MutedText}" Margin="0,4" />
                            <TextBlock x:Name="BackblazeDetailEndpointText" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Text="Adventure Land" Style="{StaticResource MutedText}" Margin="0,4" />
                            <TextBlock x:Name="TargetUrlText" Grid.Row="4" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Text="Lokale Konfiguration" Style="{StaticResource MutedText}" Margin="0,4" />
                            <TextBlock x:Name="ConfigPathText" Grid.Row="5" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
