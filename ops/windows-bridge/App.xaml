<Application x:Class="AioBotWindowsBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#10141C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#171D27" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202836" />
        <SolidColorBrush x:Key="TextBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA8BA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3FA7FF" />
        <SolidColorBrush x:Key="GoodBrush" Color="#43D17A" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFBE55" />
        <SolidColorBrush x:Key="BadBrush" Color="#FF6B75" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#344155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6D2D34" />
            <Setter Property="BorderBrush" Value="#8B4049" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1F7545" />
                    <Setter Property="BorderBrush" Value="#43D17A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#2A3445" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Application.Resources>
</Application>
