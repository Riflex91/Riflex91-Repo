<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AioBotLinuxBridge</AssemblyName>
    <RootNamespace>AioBotLinuxBridge</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BridgeBuildNumber Condition="'$(BridgeBuildNumber)' == ''">0</BridgeBuildNumber>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BridgeBuildNumber" Value="$(BridgeBuildNumber)" />
  </ItemGroup>
</Project>
