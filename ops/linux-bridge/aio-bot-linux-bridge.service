[Unit]
Description=AIO Bot Linux Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/lib/aio-bot-linux-bridge/AioBotLinuxBridge
Restart=on-failure
RestartSec=5
WorkingDirectory=%h
UMask=0077
Environment=DOTNET_EnableDiagnostics=0

[Install]
WantedBy=default.target
