# Copy to /etc/aio-bot/control.env and chmod 600.
# Generate token with: openssl rand -hex 32
AIO_CONTROL_BIND=127.0.0.1
AIO_CONTROL_PORT=8790
AIO_CONTROL_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
AIO_CONTROL_REPO_PATH=/opt/aio-bot
AIO_CONTROL_BOT_SERVICE=aio-bot.service

# Remote/LAN mode is rejected unless both TLS files are configured.
# AIO_CONTROL_BIND=0.0.0.0
# AIO_CONTROL_TLS_CERT=/etc/aio-bot/tls/control.crt
# AIO_CONTROL_TLS_KEY=/etc/aio-bot/tls/control.key
