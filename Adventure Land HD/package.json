{
  "name": "adventure-land-hd",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "inventory:verify": "node tools/verify-inventory.mjs",
    "inventory:audit": "node tools/audit-assets.mjs",
    "contracts:audit": "node tools/analyze-contracts.mjs",
