{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v5-trade-lifecycle.schema.json",
  "title": "V5 Adventure Land Trade Listing Lifecycle Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "status",
    "sourceSnapshot",
    "listingLifecycle",
    "ridSemantics",
    "partialFillSemantics",
    "tradeBuy",
    "tradeSell",
    "concurrency",
    "v5Policy",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "researchId": { "const": "V5-P0-04" },
    "status": { "const": "DONE" },
    "sourceSnapshot": { "type": "object" },
    "listingLifecycle": { "type": "object" },
    "ridSemantics": { "type": "object" },
    "partialFillSemantics": { "type": "object" },
    "tradeBuy": { "type": "object" },
    "tradeSell": { "type": "object" },
    "concurrency": { "type": "object" },
    "v5Policy": { "type": "object" },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
