{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v5-recovery-contract.schema.json",
  "title": "V5 Adventure Land Recovery Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "actionContractId",
    "publicFunction",
    "status",
    "recoveryClass",
    "unknownEntryTriggers",
    "reobserveSources",
    "settlementRules",
    "retryPolicy",
    "journalRequirements",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^AL-RECOVERY-[A-Z0-9-]+$" },
    "actionContractId": { "type": "string", "pattern": "^AL-ACTION-[A-Z0-9-]+$" },
    "publicFunction": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "VERIFIED_RECOVERY_POLICY",
        "DISABLED_WITH_ACTION_CONTRACT"
      ]
    },
    "recoveryClass": {
      "enum": [
        "STATE_REOBSERVE",
        "DUAL_VALUE_SETTLEMENT",
        "ACCOUNT_SHARED_STATE",
        "PARTIAL_BATCH_REPLAN",
        "MULTI_PHASE_Q_RECONCILE",
        "ASYNC_BACKEND_RECONCILE",
        "CLAIM_BACKEND_RECONCILE",
        "LISTING_STATE_RECONCILE",
        "RID_TRADE_RECONCILE",
        "REQUEST_RESPONSE_GAME_RECONCILE",
        "DEFERRED_SETTLEMENT_RECONCILE",
        "ROUTER_DELEGATE",
        "MIXED_PATH_RECONCILE",
        "DISABLED"
      ]
    },
    "unknownEntryTriggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "reobserveSources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "settlementRules": {
      "type": "object",
      "required": ["committed", "notApplied", "partial", "stillPending", "unresolved"],
      "properties": {
        "committed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "notApplied": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "partial": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stillPending": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "unresolved": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "retryPolicy": {
      "type": "object",
      "required": ["sameIntentAfterPossibleSend", "afterNotApplied", "afterPartial", "afterStillPending", "afterUnresolved"],
      "properties": {
        "sameIntentAfterPossibleSend": { "const": "NEVER" },
        "afterNotApplied": { "const": "NEW_INTENT_AFTER_FRESH_ADMISSION_ONLY" },
        "afterPartial": { "const": "REPLAN_REMAINDER_AS_NEW_INTENT" },
        "afterStillPending": { "const": "WAIT_AND_REOBSERVE_NO_SEND" },
        "afterUnresolved": { "const": "QUARANTINE_OR_OPERATOR_NO_SEND" }
      }
    },
    "journalRequirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
