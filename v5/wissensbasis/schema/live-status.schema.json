{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5 lokale Live-Wissensdatenbank Status",
  "type": "object",
  "required": [
    "schemaVersion",
    "spiel",
    "generation",
    "zustand",
    "aktualisiertAm"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "spiel": {
      "const": "Adventure Land - The Code MMORPG"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "zustand": {
      "enum": [
        "SCHREIBT",
        "BEREIT"
      ]
    },
    "aktualisiertAm": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
