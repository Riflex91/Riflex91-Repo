{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v5-bank-concurrency.schema.json",
  "title": "V5 Adventure Land Bank Concurrency Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "status",
    "sourceSnapshot",
    "serverModel",
    "v5Policy",
    "failureHandling",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "researchId": { "const": "V5-P0-03" },
    "status": { "const": "DONE" },
    "sourceSnapshot": { "type": "object" },
    "serverModel": { "type": "object" },
    "v5Policy": { "type": "object" },
    "failureHandling": { "type": "object" },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
