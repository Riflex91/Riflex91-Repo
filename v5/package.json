{
  "name": "adventure-land-aio-v5",
  "version": "5.0.0-r3.0",
  "private": true,
  "type": "module",
  "description": "Adventure Land AiO Bot V5 – R3 no-write Architekturgrundlage und Guards.",
  "scripts": {
    "bereinigen": "node werkzeuge/r3-bereinigen.mjs",
    "bauen": "npm run bereinigen && tsc -p tsconfig.json",
    "typen:pruefen": "tsc -p tsconfig.json --noEmit",
    "lint": "node werkzeuge/r3-statische-guards.mjs && node werkzeuge/r3-stil-pruefen.mjs",
    "format:pruefen": "node werkzeuge/r3-stil-pruefen.mjs",
    "guards:test": "node --test werkzeuge/tests/r3-guards.test.mjs",
    "host:test": "node --test werkzeuge/tests/r3-speicher-gesundheit.test.mjs",
    "testen": "npm run guards:test && npm run host:test && npm run grundlage:test",
    "r3:pruefen": "npm run typen:pruefen && npm run lint && npm run sichttext:pruefen && npm run testen && node werkzeuge/r3-struktur-pruefen.mjs",
    "grundlage:test": "npm run bauen && node --test grundlage/tests/*.test.mjs",
    "sichttext:pruefen": "node werkzeuge/r3-sichttext-pruefen.mjs && node --test werkzeuge/tests/r3-sichttext.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
